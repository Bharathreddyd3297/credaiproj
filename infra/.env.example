# =====================================================================
# CredPay - local secrets for social / enterprise login
# =====================================================================
# Copy to infra/.env (git-ignored - never commit real secrets), fill in,
# then run:  .\scripts\setup\configure-identity-providers.ps1
#
# Leave a pair empty to skip that provider.
# =====================================================================

# --- Google ("Sign in with Google" for customers) ---------------------
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID
# (Web application). Authorized redirect URI:
#   http://localhost:8081/realms/credpay/broker/google/endpoint
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
