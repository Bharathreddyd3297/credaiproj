# Local development settings for the admin portal (`npm run dev`).
# Copy to `.env`. The same defaults are built into the code, so this file
# only needs changing for another environment.
#
# Vite inlines VITE_* values at BUILD time.
VITE_USER_API_URL=http://localhost:8080
VITE_PAYMENT_API_URL=http://localhost:8000

# Keycloak (OpenID Connect)
VITE_OIDC_AUTHORITY=http://localhost:8081/realms/credpay
VITE_OIDC_CLIENT_ID=admin-portal
